# Matrix Chain Multiplication using Dynamic Programming

def matrix_chain_order(p, n):
    # m[i][j] stores minimum multiplication cost
    m = [[0 for _ in range(n)] for _ in range(n)]

    # length is the number of matrices in the chain
    for length in range(2, n):
        for i in range(1, n - length + 1):
            j = i + length - 1

            m[i][j] = float('inf')

            # Try all possible split positions
            for k in range(i, j):
                cost = (
                    m[i][k]
                    + m[k + 1][j]
                    + p[i - 1] * p[k] * p[j]
                )

                if cost < m[i][j]:
                    m[i][j] = cost

    return m[1][n - 1]


# Take input from the user
num_matrices = int(input("Enter the number of matrices: "))

print(f"Enter {num_matrices + 1} dimensions:")

p = []

for i in range(num_matrices + 1):
    dimension = int(input(f"Dimension {i + 1}: "))
    p.append(dimension)


# Find minimum multiplication cost
minimum_cost = matrix_chain_order(p, num_matrices + 1)


# Display result
print("\nMinimum number of scalar multiplications:", minimum_cost)

